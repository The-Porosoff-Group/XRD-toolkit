# gamma-MoC1-x cubic carbide template for Catalysis Toolkit.
# Rock-salt type, Fm-3m (No. 225). Carbon occupancy is fixed by the
# phase-card vacancy x value before refinement: occ(C) = 1 - x.

data_gamma_MoC1-x
_chemical_name_common                  'gamma-MoC1-x'
_chemical_formula_sum                  'Mo1 C1.00'
_chemical_formula_structural           'MoC1-x'
_cell_length_a                         4.382960
_cell_length_b                         4.382960
_cell_length_c                         4.382960
_cell_angle_alpha                      90.00000
_cell_angle_beta                       90.00000
_cell_angle_gamma                      90.00000
_cell_volume                           84.19489
_cell_formula_units_Z                  4
_symmetry_space_group_name_H-M         'F m -3 m'
_symmetry_Int_Tables_number            225
_space_group_name_H-M_alt              'F m -3 m'
_space_group_IT_number                 225

loop_
  _space_group_symop_operation_xyz
  'x, y, z'
  '-x, -y, -z'
  'x, y+1/2, z+1/2'
  'x+1/2, y, z+1/2'
  'x+1/2, y+1/2, z'
  '-x, -y+1/2, -z+1/2'
  '-x+1/2, -y, -z+1/2'
  '-x+1/2, -y+1/2, -z'

loop_
  _atom_site_label
  _atom_site_type_symbol
  _atom_site_fract_x
  _atom_site_fract_y
  _atom_site_fract_z
  _atom_site_occupancy
  Mo1  Mo  0.000000  0.000000  0.000000  1.0000
  C1   C   0.500000  0.500000  0.500000  1.0000
